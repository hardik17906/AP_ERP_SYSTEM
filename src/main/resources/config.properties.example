# Copy this file to config.properties and set your local MySQL credentials.
auth.jdbcUrl=jdbc:mysql://localhost:3306/auth_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
auth.username=root
auth.password=YOUR_LOCAL_MYSQL_PASSWORD

erp.jdbcUrl=jdbc:mysql://localhost:3306/erp_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
erp.username=root
erp.password=YOUR_LOCAL_MYSQL_PASSWORD
